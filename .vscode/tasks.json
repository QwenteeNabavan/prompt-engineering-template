{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run project (Backend + Frontend)",
      "dependsOn": ["Run backend", "Run frontend"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "statusbar": {
          "label": "$(play) Run AgentHub",
          "tooltip": "Запустити FastAPI бекенд (8001) + React фронтенд (5174)",
          "color": "#22d3ee"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Verify All (Linters + Types + Tests)",
      "type": "shell",
      "command": "python .agents/skills/fullstack-verification/scripts/verify-all.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "label": "$(Pass) Verify All",
          "tooltip": "Запустити Ruff, Mypy, Oxlint, Prettier, TSC, Vite Build та API тести",
          "color": "#34d399"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run backend",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "statusbar": {
          "hide": true
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      }
    },
    {
      "label": "Run frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "statusbar": {
          "hide": true
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Install backend dependencies",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "statusbar": {
          "hide": true
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Install frontend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "statusbar": {
          "hide": true
        }
      },
      "problemMatcher": []
    }
  ]
}
