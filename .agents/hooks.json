{
  "backend-cross-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/backend-guard.py",
        "timeout": 90
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/backend-guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "frontend-cross-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/frontend-guard.py",
        "timeout": 90
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/frontend-guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "data-integrity-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/guard-integrity.py",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/guard-integrity.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
