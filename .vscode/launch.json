{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "Run frontend"
    },
    {
      "name": "Start Backend Only",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "jinja": true,
      "justMyCode": true
    }
  ]
}
